<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>أطلس التشريح التمريضي ثلاثي الأبعاد | 3D Nursing Anatomy</title>
  <style>
    :root {
      --bg-dark: #070b14;
      --panel-bg: rgba(13, 20, 36, 0.88);
      --panel-border: rgba(56, 189, 248, 0.22);
      --accent: #0ea5e9;
      --accent-glow: #38bdf8;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: radial-gradient(circle at 55% 40%, #132038 0%, #070b14 75%);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: var(--text-main);
      touch-action: none;
    }

    /* الشريط العلوي البسيط */
    .top-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 48px;
      background: rgba(7, 11, 20, 0.85);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--panel-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      z-index: 30;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      font-size: 14px;
      color: var(--accent-glow);
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-top {
      background: rgba(30, 41, 59, 0.85);
      border: 1px solid rgba(148, 163, 184, 0.25);
      color: var(--text-main);
      padding: 5px 10px;
      border-radius: 8px;
      font-size: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      transition: 0.2s;
    }

    .btn-top:hover, .btn-top.active {
      background: var(--accent);
      border-color: var(--accent-glow);
      color: #fff;
    }

    /* مساحة العرض ثلاثي الأبعاد */
    #canvas-container {
      position: fixed;
      top: 48px;
      bottom: 54px;
      left: 0;
      right: 0;
      z-index: 1;
      touch-action: none;
      cursor: grab;
    }

    #canvas-container:active {
      cursor: grabbing;
    }

    /* القائمة الجانبية على الشمال (Left Sidebar) */
    .left-sidebar {
      position: fixed;
      top: 56px;
      left: 10px;
      bottom: 62px;
      width: 215px;
      background: var(--panel-bg);
      backdrop-filter: blur(12px);
      border: 1px solid var(--panel-border);
      border-radius: 14px;
      z-index: 20;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .left-sidebar.collapsed {
      transform: translateX(-230px);
      opacity: 0;
      pointer-events: none;
    }

    .sidebar-header {
      padding: 10px 12px;
      background: rgba(15, 23, 42, 0.9);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 12px;
      font-weight: 700;
      color: var(--accent-glow);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* فلاتر الطبقات السريعة */
    .layer-toggles {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px;
      padding: 8px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(15, 23, 42, 0.5);
    }

    .layer-btn {
      background: rgba(30, 41, 59, 0.9);
      border: 1px solid rgba(56, 189, 248, 0.3);
      color: #e2e8f0;
      font-size: 11px;
      padding: 5px 4px;
      border-radius: 6px;
      cursor: pointer;
      text-align: center;
      transition: 0.15s;
    }

    .layer-btn.active {
      background: rgba(14, 165, 233, 0.28);
      border-color: var(--accent-glow);
      color: #fff;
      font-weight: 600;
    }

    .layer-btn.hidden-layer {
      opacity: 0.45;
      border-color: transparent;
      text-decoration: line-through;
    }

    /* بحث سريع داخل القائمة */
    .search-box {
      padding: 6px 8px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .search-box input {
      width: 100%;
      background: rgba(7, 11, 20, 0.8);
      border: 1px solid rgba(148, 163, 184, 0.25);
      border-radius: 7px;
      padding: 5px 8px;
      color: #fff;
      font-size: 11px;
      outline: none;
    }

    .search-box input:focus {
      border-color: var(--accent-glow);
    }

    /* قائمة الأجزاء التشريحية */
    .items-list {
      flex: 1;
      overflow-y: auto;
      padding: 6px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      touch-action: pan-y;
    }

    .cat-title {
      font-size: 10px;
      color: var(--text-muted);
      padding: 6px 4px 2px;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .part-item {
      background: rgba(30, 41, 59, 0.55);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 8px;
      padding: 7px 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: 0.15s;
      text-align: right;
    }

    .part-item:hover, .part-item.selected {
      background: rgba(14, 165, 233, 0.25);
      border-color: var(--accent-glow);
    }

    .part-item-name {
      font-size: 12px;
      font-weight: 600;
      color: #f1f5f9;
      display: block;
    }

    .part-item-en {
      font-size: 10px;
      color: var(--text-muted);
      display: block;
    }

    .part-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    /* زر إظهار/إخفاء القائمة على الشمال للموبايل */
    .toggle-left-btn {
      position: fixed;
      top: 58px;
      left: 10px;
      z-index: 25;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 7px 11px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(14, 165, 233, 0.4);
      display: none;
    }

    .left-sidebar.collapsed ~ .toggle-left-btn {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    /* شارة الاسم الفورية عند الضغط على أي عضو */
    .instant-badge {
      position: fixed;
      top: 58px;
      right: 12px;
      z-index: 22;
      background: rgba(13, 20, 36, 0.92);
      border: 1px solid var(--accent-glow);
      border-radius: 12px;
      padding: 8px 14px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.55);
      max-width: calc(100vw - 245px);
      transition: 0.25s;
    }

    .instant-badge .hint-label {
      font-size: 10px;
      color: var(--accent-glow);
      display: block;
      margin-bottom: 2px;
    }

    .instant-badge .title-ar {
      font-size: 15px;
      font-weight: 800;
      color: #fff;
    }

    .instant-badge .title-sub {
      font-size: 11px;
      color: #cbd5e1;
      margin-top: 1px;
    }

    /* بطاقة المعلومات البسيطة (تفتح عند الضغط على أي جزء) */
    .info-card {
      position: fixed;
      bottom: 62px;
      right: 12px;
      width: 340px;
      max-width: calc(100vw - 24px);
      max-height: 46vh;
      background: var(--panel-bg);
      backdrop-filter: blur(14px);
      border: 1px solid var(--panel-border);
      border-radius: 14px;
      padding: 12px 14px;
      z-index: 24;
      overflow-y: auto;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.65);
      touch-action: pan-y;
      transition: transform 0.25s ease, opacity 0.25s ease;
    }

    .info-card.minimized {
      max-height: 44px;
      overflow: hidden;
    }

    .info-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
      padding-bottom: 6px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .info-actions {
      display: flex;
      gap: 6px;
    }

    .icon-btn {
      background: rgba(56, 189, 248, 0.15);
      border: 1px solid rgba(56, 189, 248, 0.35);
      color: #fff;
      border-radius: 7px;
      padding: 4px 8px;
      font-size: 11px;
      cursor: pointer;
    }

    .info-section {
      margin-bottom: 8px;
      font-size: 12px;
      line-height: 1.55;
      color: #e2e8f0;
    }

    .info-section strong {
      color: var(--accent-glow);
      display: block;
      margin-bottom: 2px;
      font-size: 11.5px;
    }

    .red-flag-box {
      background: rgba(239, 68, 68, 0.14);
      border-right: 3px solid var(--danger);
      padding: 6px 9px;
      border-radius: 6px;
      font-size: 11.5px;
      color: #fecaca;
      margin-top: 6px;
    }

    /* وضع الاختبار السريع */
    .quiz-banner {
      position: fixed;
      top: 56px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(135deg, #1e1b4b, #0f172a);
      border: 1px solid #818cf8;
      padding: 8px 16px;
      border-radius: 12px;
      z-index: 28;
      display: none;
      align-items: center;
      gap: 10px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
      font-size: 12.5px;
    }

    /* شريط الإعلانات المدمج للربح في أسفل الشاشة */
    .ad-banner-slot {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 54px;
      background: #050811;
      border-top: 1px solid rgba(148, 163, 184, 0.18);
      z-index: 35;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 10px;
    }

    .ad-placeholder {
      width: 100%;
      max-width: 728px;
      height: 42px;
      border: 1px dashed rgba(56, 189, 248, 0.35);
      border-radius: 8px;
      background: rgba(15, 23, 42, 0.6);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      font-size: 11px;
      color: #94a3b8;
    }

    .ad-tag {
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 700;
    }

    /* التوافق مع شاشات الهواتف الصغيرة */
    @media (max-width: 700px) {
      .left-sidebar {
        width: 175px;
      }
      .instant-badge {
        max-width: calc(100vw - 200px);
        padding: 6px 10px;
      }
      .instant-badge .title-ar {
        font-size: 13px;
      }
      .info-card {
        width: calc(100vw - 20px);
        right: 10px;
        max-height: 36vh;
      }
    }
  </style>
</head>
<body>

  <!-- الشريط العلوي -->
  <header class="top-header">
    <div class="brand">
      <span>🩺</span>
      <span>أطلس التمريض 3D</span>
    </div>
    <div class="top-actions">
      <button class="btn-top" id="btnToggleList" onclick="toggleSidebar()">📋 القائمة</button>
      <button class="btn-top" id="btnAutoRotate" onclick="toggleAutoRotate()">🔄 دوران</button>
      <button class="btn-top" onclick="resetCamera()">🎯 توسيط</button>
      <button class="btn-top" id="btnQuiz" onclick="toggleQuiz()">🧠 اختبر نفسك</button>
    </div>
  </header>

  <!-- شريط الاختبار التفاعلي -->
  <div class="quiz-banner" id="quizBanner">
    <span id="quizQuestion">اضغط على: القلب</span>
    <button class="icon-btn" onclick="nextQuizQuestion()">سؤال آخر ⏭️</button>
    <button class="icon-btn" onclick="toggleQuiz()">إغلاق ✖</button>
  </div>

  <!-- القائمة الجانبية على الشمال (الأغراض والطبقات) -->
  <aside class="left-sidebar" id="leftSidebar">
    <div class="sidebar-header">
      <span>أجزاء الجسم (اضغط للعرض)</span>
      <button class="icon-btn" onclick="toggleSidebar()" title="تصغير القائمة">◀</button>
    </div>

    <!-- التحكم بطبقات الجسم -->
    <div class="layer-toggles">
      <button class="layer-btn active" id="layer-organs" onclick="toggleLayer('organs')">🫀 الأعضاء</button>
      <button class="layer-btn active" id="layer-skeletal" onclick="toggleLayer('skeletal')">🦴 العظام</button>
      <button class="layer-btn active" id="layer-muscular" onclick="toggleLayer('muscular')">💪 العضلات</button>
      <button class="layer-btn active" id="layer-vessels" onclick="toggleLayer('vessels')">🩸 العروق والأعصاب</button>
    </div>

    <!-- بحث سريع -->
    <div class="search-box">
      <input type="text" id="searchInput" placeholder="🔍 ابحث عن عضو أو وريد..." oninput="filterList()" />
    </div>

    <!-- قائمة الأغراض على الشمال -->
    <div class="items-list" id="itemsList"></div>
  </aside>

  <!-- زر إظهار القائمة إذا كانت مخفية -->
  <button class="toggle-left-btn" onclick="toggleSidebar()">
    <span>▶</span>
    <span>الأعضاء والأغراض</span>
  </button>

  <!-- شارة الاسم الفورية عند لمس أي جزء -->
  <div class="instant-badge" id="instantBadge">
    <span class="hint-label">👆 المس أي غرض في المجسم لمعرفة اسمه:</span>
    <div class="title-ar" id="badgeAr">القلب (موقع النبض القمي)</div>
    <div class="title-sub" id="badgeSub">Heart (Apical Pulse) | Cœur</div>
  </div>

  <!-- مساحة العرض ثلاثي الأبعاد -->
  <div id="canvas-container"></div>

  <!-- بطاقة الشرح البسيطة والواضحة -->
  <section class="info-card" id="infoCard">
    <div class="info-header">
      <div>
        <strong id="cardTitle" style="font-size:14px; color:#38bdf8;">القلب (Heart)</strong>
        <div id="cardFr" style="font-size:11px; color:#94a3b8;">المصطلح الفرنسي: Le Cœur</div>
      </div>
      <div class="info-actions">
        <button class="icon-btn" onclick="speakCurrentPart()" title="نطق الاسم بالإنجليزية">🔊 نطق</button>
        <button class="icon-btn" id="btnMinCard" onclick="toggleMinimizeCard()">🔽 تصغير</button>
      </div>
    </div>

    <div class="info-section">
      <strong>📌 ما هو هذا الجزء؟ (الوظيفة المبسطة):</strong>
      <span id="cardDesc">عضلة مضخة الدم الرئيسية، يقع في منتصف الصدر مائلاً لليسار بين الرئتين خلف عظم القص.</span>
    </div>

    <div class="info-section">
      <strong>💉 الأهمية العملية لطلاب التمريض:</strong>
      <span id="cardNursing">يُفحص النبض القمي (Apical Pulse) بوضع السماعة في الورب الخامس الأيسر على خط منتصف الترقوة (5th ICS MCL) لمدة دقيقة كاملة.</span>
    </div>

    <div class="red-flag-box" id="cardAlert">
      ⚠️ <strong>تنبيه تمريضي مهم:</strong> يجب قياس النبض القمي قبل إعطاء دواء الديجوكسين (Digoxin)، ويُوقف الدواء إذا كان النبض أقل من 60 نبضة/دقيقة في البالغين.
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 💰 مساحة الإعلانات للربح من الزوار (Ad Banner Slot) -->
  <!-- ========================================================================= -->
  <footer class="ad-banner-slot">
    <!-- ضع كود الإعلان من Adsterra أو Google AdSense هنا مكان الـ div التالي -->
    <div class="ad-placeholder" id="adContainer">
      <span><span class="ad-tag">إعلان</span> مساحة إعلانية جاهزة للربح من زيارات الطلاب (تظهر هنا بدون التأثير على المجسم)</span>
      <span style="color:#38bdf8; font-weight:600;">Ad Space 728x50</span>
    </div>
  </footer>

  <!-- مكتبة Three.js خفيفة وسريعة -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

  <script>
    // =========================================================================
    // 1. قاعدة البيانات التشريحية والتمريضية الشاملة والمبسطة
    // =========================================================================
    const ANATOMY_PARTS = [
      // --- الأعضاء الحيوية (Organs) ---
      {
        id: 'brain',
        category: 'organs',
        catLabel: '🫀 الأعضاء الحيوية',
        nameAr: 'الدماغ (المخ والمخيخ)',
        nameEn: 'Brain (Cerebrum)',
        nameFr: 'Cerveau',
        color: '#f4afab',
        cameraTarget: [0, 6.2, 0],
        cameraPos: [0, 6.5, 4.2],
        desc: 'مركز التحكم بالجهاز العصبي والوعي والحركة والتنفس، محمي داخل عظام الجمجمة.',
        nursing: 'يُقيّم الممرض وظيفة الدماغ عبر مقياس غلاسكو للغيبوبة (GCS from 3 to 15) وفحص تفاعل حدقة العين للضوء (PERRLA).',
        alert: 'أي تغير مفاجئ في مستوى الوعي أو عدم تساوي الحدقتين يدل على ارتفاع الضغط داخل الجمجمة (ICP) ويستدعي تدخلاً طارئاً.'
      },
      {
        id: 'trachea',
        category: 'organs',
        catLabel: '🫀 الأعضاء الحيوية',
        nameAr: 'القصبة الهوائية (الرغامى)',
        nameEn: 'Trachea (Airway)',
        nameFr: 'Trachée',
        color: '#7dd3fc',
        cameraTarget: [0, 4.1, 0.2],
        cameraPos: [0, 4.3, 3.8],
        desc: 'أنبوب غضروفي حلقي ينقل الهواء من الحنجرة إلى الرئتين اليمنى واليسرى.',
        nursing: 'مهمة جداً في تأمين مجرى الهواء (Airway Management)، التنبيب الرغامي (Endotracheal Intubation)، وتشفيط المفرزات (Suctioning).',
        alert: 'لا تتجاوز مدة التشفيط الرغامي 10 إلى 15 ثانية في المرة الواحدة لتجنب نقص الأكسجة (Hypoxia).'
      },
      {
        id: 'heart',
        category: 'organs',
        catLabel: '🫀 الأعضاء الحيوية',
        nameAr: 'القلب (النبض القمي)',
        nameEn: 'Heart (Apical Pulse)',
        nameFr: 'Cœur',
        color: '#dc2626',
        cameraTarget: [0.25, 2.55, 0.55],
        cameraPos: [0.3, 2.7, 4.2],
        desc: 'المضخة العضلية للدورة الدموية، يتكون من 4 حجرات (أذينين وبطينين) وصمامات تمنع رجوع الدم.',
        nursing: 'موضع تسمّع الصمام التاجي والنبض القمي (Apical Pulse) يقع في المسافة الوربية الخامسة (5th ICS) على خط منتصف الترقوة الأيسر.',
        alert: 'افحص النبض القمي لمدة دقيقة كاملة قبل إعطاء دواء الديجوكسين (Digoxin)؛ أوقف الجرعة إذا كان أقل من 60 نبضة/دقيقة.'
      },
      {
        id: 'lungs',
        category: 'organs',
        catLabel: '🫀 الأعضاء الحيوية',
        nameAr: 'الرئتان (اليمنى واليسرى)',
        nameEn: 'Lungs (Right & Left)',
        nameFr: 'Poumons',
        color: '#fda4af',
        cameraTarget: [0, 2.7, 0.2],
        cameraPos: [0, 2.9, 5.0],
        desc: 'عضوا التنفس وتبادل الغازات (إدخال الأكسجين وإخراج ثاني أكسيد الكربون)؛ الرئة اليمنى 3 فصوص واليسرى فصان.',
        nursing: 'تسمّع أصوات التنفس بالطريقة المتعرجة (Zigzag) للمقارنة بين الجهتين، ومراقبة تشبع الأكسجين (SpO2 طبيعي 95%-100%).',
        alert: 'غياب صوت الهواء في جهة واحدة بعد تركيب أنبوب التنفس قد يعني دخوله في القصبة اليمنى فقط أو حدوث استرواح صدري.'
      },
      {
        id: 'liver',
        category: 'organs',
        catLabel: '🫀 الأعضاء الحيوية',
        nameAr: 'الكبد والمرارة',
        nameEn: 'Liver & Gallbladder',

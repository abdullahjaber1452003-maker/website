        registerMesh(clav, 'sternum_ribs', 'skeletal');

        // عظم العضد (Humerus)
        const hum = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.12, 2.1, 16), makeBoneMat());
        hum.position.set(side * 1.65, 2.65, 0);
        hum.rotation.z = side * 0.12;
        registerMesh(hum, 'sternum_ribs', 'skeletal');

        // عظام الساعد (Radius & Ulna)
        const forearm = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.1, 2.0, 16), makeBoneMat());
        forearm.position.set(side * 2.1, 0.75, 0.15);
        forearm.rotation.z = side * 0.18;
        registerMesh(forearm, 'sternum_ribs', 'skeletal');

        // عظم الفخذ (Femur)
        const femur = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.16, 2.9, 18), makeBoneMat());
        femur.position.set(side * 0.78, -2.35, 0);
        registerMesh(femur, 'spine_pelvis', 'skeletal');
      });

      // 4) عظم القص والقفص الصدري (Sternum & Ribs)
      const sternum = new THREE.Mesh(new THREE.BoxGeometry(0.32, 1.65, 0.14), makeBoneMat());
      sternum.position.set(0, 2.85, 0.72);
      registerMesh(sternum, 'sternum_ribs', 'skeletal');

      for (let r = 0; r < 9; r++) {
        const y = 3.6 - r * 0.24;
        const radius = 0.85 + Math.sin((r / 8) * Math.PI) * 0.35;
        [-1, 1].forEach(side => {
          const rib = new THREE.Mesh(new THREE.TorusGeometry(radius, 0.055, 10, 24, Math.PI * 0.88), makeBoneMat());
          rib.rotation.x = Math.PI / 2 + 0.18;
          rib.rotation.z = side > 0 ? -0.25 : Math.PI + 0.25;
          rib.position.set(side * 0.15, y, 0.05);
          registerMesh(rib, 'sternum_ribs', 'skeletal');
        });
      }

      // 5) القصبة الهوائية (Trachea)
      const tracheaMat = makeOrganMat(0x7dd3fc, 0.3);
      const trachea = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.16, 1.35, 20), tracheaMat);
      trachea.position.set(0, 4.15, 0.12);
      registerMesh(trachea, 'trachea', 'organs');

      // 6) القلب النابض (Heart)
      heartGroup = new THREE.Group();
      heartGroup.position.set(0.26, 2.55, 0.38);
      const heartMat = makeOrganMat(0xdc2626, 0.22);
      const leftVentricle = new THREE.Mesh(new THREE.SphereGeometry(0.42, 24, 24), heartMat);
      leftVentricle.scale.set(0.95, 1.25, 0.9);
      leftVentricle.rotation.z = 0.45;
      registerMesh(leftVentricle, 'heart', 'organs');
      heartGroup.add(leftVentricle);
      layerGroups.organs.add(heartGroup);

      // 7) الرئتان (Lungs)
      const lungMat = makeOrganMat(0xfda4af, 0.38);
      rightLungMesh = new THREE.Mesh(new THREE.SphereGeometry(0.65, 24, 24), lungMat.clone());
      rightLungMesh.scale.set(0.82, 1.45, 0.85);
      rightLungMesh.position.set(-0.65, 2.8, 0.15);
      registerMesh(rightLungMesh, 'lungs', 'organs');

      leftLungMesh = new THREE.Mesh(new THREE.SphereGeometry(0.62, 24, 24), lungMat.clone());
      leftLungMesh.scale.set(0.78, 1.4, 0.85);
      leftLungMesh.position.set(0.68, 2.8, 0.12);
      registerMesh(leftLungMesh, 'lungs', 'organs');

      // 8) الكبد (Liver)
      const liverMat = makeOrganMat(0x881337, 0.25);
      const liver = new THREE.Mesh(new THREE.SphereGeometry(0.68, 24, 24), liverMat);
      liver.scale.set(1.25, 0.65, 0.8);
      liver.position.set(-0.38, 1.45, 0.28);
      liver.rotation.z = 0.22;
      registerMesh(liver, 'liver', 'organs');

      // 9) المعدة (Stomach)
      const stomachMat = makeOrganMat(0xf43f5e, 0.28);
      const stomach = new THREE.Mesh(new THREE.TorusGeometry(0.36, 0.22, 16, 28, Math.PI * 1.15), stomachMat);
      stomach.position.set(0.45, 1.32, 0.25);
      stomach.rotation.z = -0.8;
      registerMesh(stomach, 'stomach', 'organs');

      // 10) الكليتان (Kidneys)
      const kidneyMat = makeOrganMat(0x9f1239, 0.3);
      [-0.48, 0.48].forEach(x => {
        const kidney = new THREE.Mesh(new THREE.SphereGeometry(0.28, 20, 20), kidneyMat.clone());
        kidney.scale.set(0.75, 1.25, 0.65);
        kidney.position.set(x, 0.95, -0.15);
        registerMesh(kidney, 'kidneys', 'organs');
      });

      // 11) الأمعاء الدقيقة والغليظة (Intestines)
      const colonMat = makeOrganMat(0xe11d48, 0.35);
      const colonFrame = new THREE.Mesh(new THREE.TorusGeometry(0.68, 0.19, 16, 32, Math.PI * 1.45), colonMat);
      colonFrame.position.set(0, 0.18, 0.25);
      colonFrame.rotation.z = -0.45;
      registerMesh(colonFrame, 'intestines', 'organs');

      const smallIntMat = makeOrganMat(0xfb7185, 0.32);
      for (let i = 0; i < 4; i++) {
        const coil = new THREE.Mesh(new THREE.TorusGeometry(0.36 - i * 0.04, 0.13, 14, 24), smallIntMat.clone());
        coil.position.set((i % 2 === 0 ? 0.08 : -0.08), 0.35 - i * 0.18, 0.32);
        coil.rotation.x = 0.4 * i;
        registerMesh(coil, 'intestines', 'organs');
      }

      // 12) المثانة البولية (Bladder)
      const bladderMat = makeOrganMat(0xf59e0b, 0.28);
      const bladder = new THREE.Mesh(new THREE.SphereGeometry(0.32, 22, 22), bladderMat);
      bladder.scale.set(1.0, 0.85, 0.9);
      bladder.position.set(0, -0.82, 0.35);
      registerMesh(bladder, 'bladder', 'organs');

      // 13) الشرايين والأوردة الكبرى + أوردة الذراع + العصب الوركي
      const aortaMat = makeOrganMat(0xef4444, 0.25);
      const aorta = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.11, 3.6, 16), aortaMat);
      aorta.position.set(0.08, 1.9, -0.08);
      registerMesh(aorta, 'aorta_vena', 'vessels');

      const venaMat = makeOrganMat(0x1d4ed8, 0.25);
      const venaCava = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.12, 3.6, 16), venaMat);
      venaCava.position.set(-0.14, 1.9, -0.05);
      registerMesh(venaCava, 'aorta_vena', 'vessels');

      // الوريد الرأسي (Cephalic Vein) - الذراع اليسرى واليمنى
      const cephMat = makeOrganMat(0x0284c7, 0.2);
      [-1, 1].forEach(side => {
        const ceph = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.045, 3.4, 14), cephMat.clone());
        ceph.position.set(side * 2.02, 1.6, 0.22);
        ceph.rotation.z = side * 0.16;
        registerMesh(ceph, 'cephalic_vein', 'vessels');
      });

      // الوريد المرفقي الأوسط (Median Cubital Vein)
      const medianMat = makeOrganMat(0x38bdf8, 0.18);
      [-1, 1].forEach(side => {
        const med = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 0.55, 14), medianMat.clone());
        med.position.set(side * 1.92, 1.65, 0.28);
        med.rotation.z = side * 0.95;
        registerMesh(med, 'median_cubital', 'vessels');
      });

      // الوريد الباسلي (Basilic Vein)
      const basilicMat = makeOrganMat(0x2563eb, 0.2);
      [-1, 1].forEach(side => {
        const bas = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.045, 3.3, 14), basilicMat.clone());
        bas.position.set(side * 1.78, 1.55, 0.2);
        bas.rotation.z = side * 0.15;
        registerMesh(bas, 'basilic_vein', 'vessels');
      });

      // العصب الوركي (Sciatic Nerve) باللون الأصفر الواضح
      const nerveMat = makeOrganMat(0xfacc15, 0.2);
      [-1, 1].forEach(side => {
        const sciatic = new THREE.Mesh(new THREE.CylinderGeometry(0.065, 0.05, 3.2, 14), nerveMat.clone());
        sciatic.position.set(side * 0.68, -2.1, -0.22);
        registerMesh(sciatic, 'sciatic_nerve', 'vessels');
      });

      // 14) العضلات ومواقع الحقن العضلي (Deltoid, Vastus Lateralis, Pectoralis/Abs)
      [-1, 1].forEach(side => {
        // العضلة الدالية (Deltoid)
        const delt = new THREE.Mesh(new THREE.SphereGeometry(0.38, 20, 20), makeMuscleMat(0xb91c1c));
        delt.scale.set(0.85, 1.35, 0.95);
        delt.position.set(side * 1.55, 3.48, 0.05);
        registerMesh(delt, 'deltoid', 'muscular');

        // العضلة المتسعة الوحشية في الفخذ (Vastus Lateralis)
        const vastus = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.2, 2.5, 20), makeMuscleMat(0xdc2626));
        vastus.position.set(side * 0.96, -2.3, 0.15);
        registerMesh(vastus, 'vastus_lateralis', 'muscular');
      });

      // عضلات الصدر والبطن (Pectoralis & Rectus Abdominis)
      [-0.45, 0.45].forEach(x => {
        const pec = new THREE.Mesh(new THREE.BoxGeometry(0.75, 0.75, 0.16), makeMuscleMat(0x991b1b));
        pec.position.set(x, 3.15, 0.78);
        registerMesh(pec, 'pectoralis_abs', 'muscular');
      });
      const abs = new THREE.Mesh(new THREE.BoxGeometry(0.85, 1.6, 0.14), makeMuscleMat(0x991b1b));
      abs.position.set(0, 1.0, 0.76);
      registerMesh(abs, 'pectoralis_abs', 'muscular');
    }

    buildAnatomicalBody();

    // =========================================================================
    // 4. بناء القائمة على الشمال + نظام الضغط المباشر (Tap-to-Identify)
    // =========================================================================
    let selectedPartId = 'heart';
    let targetCamPos = null;
    let targetLookAt = null;
    let autoRotate = false;
    let quizActive = false;
    let currentQuizTarget = null;

    function renderLeftList(filterText = '') {
      const listEl = document.getElementById('itemsList');
      listEl.innerHTML = '';
      const q = filterText.trim().toLowerCase();

      const categories = ['organs', 'vessels', 'muscular', 'skeletal'];
      categories.forEach(cat => {
        const items = ANATOMY_PARTS.filter(p =>
          p.category === cat &&
          (!q || p.nameAr.toLowerCase().includes(q) || p.nameEn.toLowerCase().includes(q) || p.nameFr.toLowerCase().includes(q))
        );
        if (items.length === 0) return;

        const title = document.createElement('div');
        title.className = 'cat-title';
        title.textContent = items[0].catLabel;
        listEl.appendChild(title);

        items.forEach(part => {
          const btn = document.createElement('div');
          btn.className = 'part-item' + (part.id === selectedPartId ? ' selected' : '');
          btn.id = 'item-' + part.id;
          btn.onclick = () => selectPart(part.id, true);
          btn.innerHTML = `
            <div>
              <span class="part-item-name">${part.nameAr}</span>
              <span class="part-item-en">${part.nameEn}</span>
            </div>
            <span class="part-dot" style="background:${part.color}"></span>
          `;
          listEl.appendChild(btn);
        });
      });
    }

    function filterList() {
      const val = document.getElementById('searchInput').value;
      renderLeftList(val);
    }

    function selectPart(partId, moveCamera = true) {
      const part = ANATOMY_PARTS.find(p => p.id === partId);
      if (!part) return;

      // فحص وضع الاختبار إذا كان مفعلاً
      if (quizActive && currentQuizTarget) {
        if (partId === currentQuizTarget.id) {
          document.getElementById('quizQuestion').innerHTML = `✅ أحسنت! هذا هو <strong>${part.nameAr}</strong>`;
          setTimeout(nextQuizQuestion, 1400);
        } else {
          document.getElementById('quizQuestion').innerHTML = `❌ خطأ، أنت ضغطت على (${part.nameAr}). حاول مجدداً: <strong>${currentQuizTarget.nameAr}</strong>`;
        }
      }

      selectedPartId = partId;

      // تحديث إضاءة الجزء المختار في المجسم 3D
      clickableMeshes.forEach(m => {
        if (m.material && m.material.emissive) {
          m.material.emissive.setHex(m.userData.partId === partId ? 0x0ea5e9 : 0x000000);
          m.material.emissiveIntensity = m.userData.partId === partId ? 0.55 : 0;
        }
      });

      // تحديث القائمة على الشمال
      document.querySelectorAll('.part-item').forEach(el => el.classList.remove('selected'));
      const activeItem = document.getElementById('item-' + partId);
      if (activeItem) {
        activeItem.classList.add('selected');
        activeItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // تحديث شارة الاسم الفورية وبطاقة المعلومات
      document.getElementById('badgeAr').textContent = part.nameAr;
      document.getElementById('badgeSub').textContent = `${part.nameEn} | ${part.nameFr}`;

      document.getElementById('cardTitle').textContent = `${part.nameAr} (${part.nameEn})`;
      document.getElementById('cardFr').textContent = `المصطلح الفرنسي: ${part.nameFr}`;
      document.getElementById('cardDesc').textContent = part.desc;
      document.getElementById('cardNursing').textContent = part.nursing;
      document.getElementById('cardAlert').innerHTML = `⚠️ <strong>تنبيه تمريضي مهم:</strong> ${part.alert}`;

      // تحريك الكاميرا بنعومة نحو الجزء المختار
      if (moveCamera && part.cameraPos && part.cameraTarget) {
        targetCamPos = new THREE.Vector3(...part.cameraPos);
        targetLookAt = new THREE.Vector3(...part.cameraTarget);
      }
    }

    // =========================================================================
    // 5. التقاط اللمس والضغط بدقة عالية على الهاتف والكمبيوتر (Raycaster)
    // =========================================================================
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    let pointerDownPos = { x: 0, y: 0 };
    let pointerDownTime = 0;

    renderer.domElement.addEventListener('pointerdown', (e) => {
      pointerDownPos = { x: e.clientX, y: e.clientY };
      pointerDownTime = performance.now();
      // إيقاف الحركة التلقائية للكاميرا عند لمس المستخدم للشاشة
      targetCamPos = null;
      targetLookAt = null;
    });

    renderer.domElement.addEventListener('pointerup', (e) => {
      const dx = e.clientX - pointerDownPos.x;
      const dy = e.clientY - pointerDownPos.y;
      const dist = Math.hypot(dx, dy);
      const elapsed = performance.now() - pointerDownTime;

      // إذا كانت نقرة سريعة (Tap) وليست سحباً للتدوير
      if (dist < 10 && elapsed < 380) {
        const rect = renderer.domElement.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(pointer, camera);
        const visibleMeshes = clickableMeshes.filter(m => m.parent && m.parent.visible && m.visible);
        const intersects = raycaster.intersectObjects(visibleMeshes, false);

        if (intersects.length > 0) {
          const hitMesh = intersects[0].object;
          if (hitMesh.userData.partId) {
            selectPart(hitMesh.userData.partId, false);
          }
        }
      }
    });

    // =========================================================================
    // 6. وظائف التحكم (الطبقات، الصوت، الاختبار، الكاميرا)
    // =========================================================================
    function toggleLayer(layerName) {
      const group = layerGroups[layerName];
      const btn = document.getElementById('layer-' + layerName);
      group.visible = !group.visible;
      if (group.visible) {
        btn.classList.add('active');
        btn.classList.remove('hidden-layer');
      } else {
        btn.classList.remove('active');
        btn.classList.add('hidden-layer');
      }
    }

    function toggleSidebar() {
      document.getElementById('leftSidebar').classList.toggle('collapsed');
    }

    function toggleMinimizeCard() {
      const card = document.getElementById('infoCard');
      const btn = document.getElementById('btnMinCard');
      card.classList.toggle('minimized');
      btn.textContent = card.classList.contains('minimized') ? '🔼 تكبير' : '🔽 تصغير';
    }

    function toggleAutoRotate() {
      autoRotate = !autoRotate;
      controls.autoRotate = autoRotate;
      controls.autoRotateSpeed = 1.6;
      document.getElementById('btnAutoRotate').classList.toggle('active', autoRotate);
    }

    function resetCamera() {
      targetCamPos = new THREE.Vector3(0, 1.5, 11.5);
      targetLookAt = new THREE.Vector3(0, 1.2, 0);
    }

    function speakCurrentPart() {
      const part = ANATOMY_PARTS.find(p => p.id === selectedPartId);
      if (!part || !('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(part.nameEn);
      utter.lang = 'en-US';
      utter.rate = 0.9;
      window.speechSynthesis.speak(utter);
    }

    function toggleQuiz() {
      quizActive = !quizActive;
      const banner = document.getElementById('quizBanner');
      document.getElementById('btnQuiz').classList.toggle('active', quizActive);
      if (quizActive) {
        banner.style.display = 'flex';
        nextQuizQuestion();
      } else {
        banner.style.display = 'none';
      }
    }

    function nextQuizQuestion() {
      const randomIndex = Math.floor(Math.random() * ANATOMY_PARTS.length);
      currentQuizTarget = ANATOMY_PARTS[randomIndex];
      document.getElementById('quizQuestion').innerHTML = `🎯 اضغط على المجسم لتحديد: <strong>${currentQuizTarget.nameAr} (${currentQuizTarget.nameEn})</strong>`;
    }

    // =========================================================================
    // 7. حلقة التحريك السلسة (نبض القلب + التنفس + حركة الكاميرا)
    // =========================================================================
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const t = clock.getElapsedTime();

      // نبض القلب الواقعي (72 نبضة/دقيقة)
      if (heartGroup) {
        const beat = 1 + Math.pow(Math.sin(t * 3.8), 6) * 0.08;
        heartGroup.scale.set(beat, beat, beat);
      }

      // حركة التنفس الهادئة للرئتين
      if (rightLungMesh && leftLungMesh) {
        const breath = 1 + Math.sin(t * 1.6) * 0.035;
        rightLungMesh.scale.set(0.82 * breath, 1.45, 0.85 * breath);
        leftLungMesh.scale.set(0.78 * breath, 1.4, 0.85 * breath);
      }

      // انتقال سلس للكاميرا عند اختيار غرض من القائمة
      if (targetCamPos && targetLookAt) {
        camera.position.lerp(targetCamPos, 0.08);
        controls.target.lerp(targetLookAt, 0.08);
        if (camera.position.distanceTo(targetCamPos) < 0.05) {
          targetCamPos = null;
          targetLookAt = null;
        }
      }

      controls.update();
      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });

    // تهيئة أولية
    renderLeftList();
    selectPart('heart', false);
    animate();
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>أطلس التشريح التمريضي ثلاثي الأبعاد | 3D Nursing Anatomy</title>
  <style>
    :root {
      --bg-dark: #060a12;
      --panel-bg: rgba(11, 18, 33, 0.90);
      --panel-border: rgba(56, 189, 248, 0.25);
      --accent: #0284c7;
      --accent-glow: #38bdf8;
      --danger: #ef4444;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: radial-gradient(circle at 58% 42%, #152542 0%, #060a12 75%);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: var(--text-main);
      touch-action: none;
    }

    /* الشريط العلوي */
    .top-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 48px;
      background: rgba(6, 10, 18, 0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--panel-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      z-index: 30;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 800;
      font-size: 14px;
      color: var(--accent-glow);
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-top {
      background: rgba(30, 41, 59, 0.9);
      border: 1px solid rgba(148, 163, 184, 0.28);
      color: var(--text-main);
      padding: 5px 10px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      transition: 0.2s;
    }

    .btn-top:hover, .btn-top.active {
      background: var(--accent);
      border-color: var(--accent-glow);
      color: #fff;
    }

    /* مساحة العرض ثلاثي الأبعاد */
    #canvas-container {
      position: fixed;
      top: 48px;
      bottom: 56px;
      left: 0;
      right: 0;
      z-index: 1;
      touch-action: none;
      cursor: grab;
    }

    #canvas-container:active {
      cursor: grabbing;
    }

